public with sharing class NumberSubtractor {
    /**
     * Subtracts the second number from the first.
     * @param num1 the minuend
     * @param num2 the subtrahend
     * @return the difference (num1 - num2)
     */
    public static Decimal subtract(Decimal num1, Decimal num2) {
        return num1 - num2;
    }
}